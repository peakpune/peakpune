<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light only. Compose draws everything; this sets the window and splash colour. -->
    <style name="Theme.PeakPune" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/peth_paper</item>
        <item name="android:statusBarColor">@color/peth_paper</item>
        <item name="android:navigationBarColor">@color/peth_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
