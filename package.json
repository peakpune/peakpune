{
  "name": "peakpune-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run metro:check && npm run build:types && node scripts/prepare-astro.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/publish-static.mjs",
    "test": "node --test",
    "dev": "npm run build && python3 -m http.server 4173 --directory public",
    "build:types": "tsc -p tsconfig.client.json",
    "pretest": "node scripts/prepare-checks.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && svelte-check --tsconfig ./tsconfig.json",
    "posttest": "node scripts/verify-ci.mjs",
    "metro:check": "node scripts/validate-metro.mjs",
    "metro:data": "node scripts/metro-gleam-data.mjs",
    "metro:build": "node scripts/metro-build.mjs",
    "metro:test": "cd metro && gleam test",
    "metro:offline": "node scripts/metro-offline-check.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/svelte": "9.1.5",
    "@types/node": "22.20.5",
    "astro": "7.4.11",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
